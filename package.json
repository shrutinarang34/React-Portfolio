    "cross-spawn": "^7.0.6",
    "crypto-browserify": "^3.12.1",
    "framer-motion": "12.29.2",
    "fs-extra": "^11.3.3",
    "isbot": "^5.1.34",
    "miniflare": "^4.20260128.0",
    "netlify": "^23.14.0",
    "nodemailer": "^7.0.13",
    "path-browserify": "^1.0.1",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-scripts": "^5.0.1",
