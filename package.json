  "description": "Portfolio site for Shruti Narang",
  "repository": "https://github.com/shrutinarang34/React-Portfolio",
  "author": "Shruti Narang",
  "sideEffects": false,
  "type": "module",
  "scripts": {
    "predeploy": "npm run build",
    "deploy": "gh-pages -d build/client",
    "dev": "node ./scripts/dev.cjs && remix vite:dev",
    "build": "remix vite:build",
    "postinstall": "node ./scripts/draco.cjs",
    "start": "netlify serve",
    "dev:storybook": "storybook dev -p 6006",
    "build:storybook": "storybook build",
    "deploy:storybook": "wrangler pages deploy ./storybook-static --project-name portfolio-storybook --branch main"
  },
